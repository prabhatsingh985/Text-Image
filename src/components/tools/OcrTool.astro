---
import Dropzone from '../Dropzone.astro';
import { IMAGE_ACCEPT } from '../../lib/input/images';
import type { Locale } from '../../i18n/locales';
import type { UiStrings } from '../../content/types';

export type OcrMode = 'text' | 'screenshot' | 'word' | 'excel' | 'pdf' | 'pdf-excel';

interface Props {
  mode: OcrMode;
  locale: Locale;
  ui: UiStrings;
}

const { mode, locale, ui } = Astro.props;
const t = ui.tool;
const isPdf = mode === 'pdf' || mode === 'pdf-excel';
const accept = isPdf ? 'application/pdf,.pdf' : mode === 'text' ? `${IMAGE_ACCEPT},application/pdf,.pdf` : IMAGE_ACCEPT;
const title = isPdf ? t.dropTitlePdf : mode === 'screenshot' ? t.dropTitleScreenshot : t.dropTitle;
const hint = isPdf ? t.dropHintPdf : mode === 'screenshot' ? t.dropHintScreenshot : t.dropHint;
const formats = isPdf ? ['PDF'] : mode === 'text' ? ['JPG', 'PNG', 'WEBP', 'HEIC', 'PDF'] : ['JPG', 'PNG', 'WEBP', 'HEIC', 'BMP'];
---

<section
  class="mx-auto max-w-5xl px-4"
  data-ocr-tool
  data-mode={mode}
  data-default-lang={locale.ocrLang}
  data-i18n={JSON.stringify(t)}
>
  <div class="card relative rounded-[2rem] p-2.5 sm:p-3">
    <Dropzone title={title} hint={hint} label={isPdf ? t.browsePdf : t.browse} formats={formats}>
      <label class="btn-primary px-6 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand-500" data-browse>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 16V4M7 9l5-5 5 5M5 20h14"></path>
        </svg>
        {isPdf ? t.browsePdf : t.browse}
        <input type="file" multiple accept={accept} class="sr-only" data-input />
      </label>
      {
        !isPdf && (
          <label class="btn-secondary hidden px-5 focus-within:outline-2 focus-within:outline-brand-500" data-camera-wrap>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 8h3l2-3h6l2 3h3v11H4z" />
              <circle cx="12" cy="13" r="3.5" />
            </svg>
            {t.camera}
            <input type="file" accept="image/*" capture="environment" class="sr-only" data-camera />
          </label>
        )
      }
      {
        mode === 'screenshot' && (
          <span class="hidden items-center gap-1.5 self-center text-sm text-ink-muted sm:inline-flex">
            <kbd class="rounded-md border border-line-strong bg-surface px-1.5 py-0.5 font-mono text-xs font-semibold text-ink shadow-[0_1px_0_var(--line-strong)]">Ctrl</kbd>
            +
            <kbd class="rounded-md border border-line-strong bg-surface px-1.5 py-0.5 font-mono text-xs font-semibold text-ink shadow-[0_1px_0_var(--line-strong)]">V</kbd>
          </span>
        )
      }
    </Dropzone>

  </div>

  <div class="mt-6 flex flex-wrap items-center gap-2" data-toolbar hidden>
    <span class="me-auto inline-flex items-center gap-2 text-sm font-semibold" data-summary></span>
  </div>

  <ol class="mt-4 space-y-4" data-results aria-live="polite"></ol>

  <template data-item-template>
    <li class="card group/item animate-fade-up overflow-hidden" data-item>
      <div class="flex items-center gap-3 px-5 py-3.5">
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-surface-2 text-ink-muted" aria-hidden="true">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
            <path d="M14 3v5h5"></path>
          </svg>
        </span>
        <span class="min-w-0 truncate text-sm font-semibold" data-name></span>
        <span class="ms-auto inline-flex shrink-0 items-center gap-1.5 rounded-full bg-surface-2 px-2.5 py-1 text-xs font-medium text-ink-muted group-data-[done]/item:bg-emerald-50 group-data-[done]/item:text-emerald-700 dark:group-data-[done]/item:bg-emerald-900/20 dark:group-data-[done]/item:text-emerald-300" data-status></span>
        <button type="button" class="btn-ghost btn-sm -me-2 h-8 w-8 p-0!" data-remove aria-label={t.remove}>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M5.3 5.3a1 1 0 0 1 1.4 0L10 8.6l3.3-3.3a1 1 0 1 1 1.4 1.4L11.4 10l3.3 3.3a1 1 0 0 1-1.4 1.4L10 11.4l-3.3 3.3a1 1 0 0 1-1.4-1.4L8.6 10 5.3 6.7a1 1 0 0 1 0-1.4Z"></path>
          </svg>
        </button>
      </div>
      <div class="h-0.5 bg-line" data-progress>
        <div class="h-full w-0 bg-brand-500 transition-[width] duration-300" data-bar></div>
      </div>
      <div class="grid gap-4 p-4 sm:p-5 lg:grid-cols-2" data-body>
        <div data-preview-col>
          <div class="relative overflow-hidden rounded-2xl border border-line bg-surface-2" data-preview></div>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" class="btn-secondary btn-sm" data-rotate>
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7"></path>
              </svg>
              {t.rotate}
            </button>
            <button type="button" class="btn-secondary btn-sm" data-retry>{t.retry}</button>
          </div>
          <p class="mt-2 text-xs text-ink-muted" data-hint hidden>{t.overlayHint}</p>
        </div>
        <div class="flex min-w-0 flex-col">
          <textarea class="field min-h-64 flex-1 resize-y rounded-2xl bg-surface-2/50 p-4 leading-7" spellcheck="false" data-text dir="auto"></textarea>
          <div class="max-h-[32rem] space-y-4 overflow-auto rounded-2xl border border-line" data-table-wrap hidden></div>
          <p class="mt-2 text-xs text-ink-muted" data-note hidden></p>
          <p class="mt-2 text-xs text-amber-700 dark:text-amber-300" data-uncertain hidden></p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="me-auto text-xs font-medium text-ink-soft" data-count></span>
            <div class="flex flex-wrap gap-2" data-actions></div>
          </div>
        </div>
      </div>
    </li>
  </template>
</section>

<script>
  import { initOcrTool } from '../../scripts/ocr-tool';
  document.querySelectorAll<HTMLElement>('[data-ocr-tool]').forEach(initOcrTool);
</script>
