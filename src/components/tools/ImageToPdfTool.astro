---
import Dropzone from '../Dropzone.astro';
import { IMAGE_ACCEPT } from '../../lib/input/images';
import type { UiStrings } from '../../content/types';

interface Props {
  ui: UiStrings;
}

const t = Astro.props.ui.tool;
---

<section class="mx-auto max-w-5xl px-4" data-image-pdf data-i18n={JSON.stringify(t)}>
  <div class="card relative rounded-[2rem] p-2.5 sm:p-3">
    <Dropzone title={t.dropTitle} hint={t.dropHint} label={t.browse} formats={['JPG', 'PNG', 'WEBP', 'HEIC', 'GIF']}>
      <label class="btn-primary px-6 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand-500">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 16V4M7 9l5-5 5 5M5 20h14"></path>
        </svg>
        {t.browse}
        <input type="file" multiple accept={IMAGE_ACCEPT} class="sr-only" data-input />
      </label>
      <label class="btn-secondary hidden px-5 focus-within:outline-2 focus-within:outline-brand-500" data-camera-wrap>
        {t.camera}
        <input type="file" accept="image/*" capture="environment" class="sr-only" data-camera />
      </label>
    </Dropzone>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 px-3 pt-4 pb-2 text-sm">
      <label class="inline-flex items-center gap-2">
        <span class="font-medium text-ink-muted">{t.pageSize}</span>
        <select class="field py-1.5" data-size>
          <option value="a4">{t.sizeA4}</option>
          <option value="letter">{t.sizeLetter}</option>
          <option value="fit">{t.sizeFit}</option>
        </select>
      </label>
      <label class="inline-flex items-center gap-2">
        <span class="font-medium text-ink-muted">{t.orientation}</span>
        <select class="field py-1.5" data-orientation>
          <option value="auto">{t.orientAuto}</option>
          <option value="portrait">{t.orientPortrait}</option>
          <option value="landscape">{t.orientLandscape}</option>
        </select>
      </label>
      <label class="inline-flex items-center gap-2">
        <span class="font-medium text-ink-muted">{t.margin}</span>
        <select class="field py-1.5" data-margin>
          <option value="0">{t.marginNone}</option>
          <option value="18" selected>{t.marginSmall}</option>
          <option value="36">{t.marginLarge}</option>
        </select>
      </label>
      <label class="opt">
        <input type="checkbox" data-smaller />
        {t.smaller}
      </label>
    </div>
  </div>

  <div class="mt-6" data-workspace hidden>
    <div class="flex flex-wrap items-center gap-2">
      <span class="me-auto text-sm font-semibold" data-summary></span>
      <button type="button" class="btn-secondary btn-sm" data-clear>{t.clearAll}</button>
      <button type="button" class="btn-primary" data-create>{t.createPdf}</button>
    </div>
    <p class="mt-2 text-xs text-ink-muted">{t.dragHint}</p>
    <ol class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5" data-list></ol>
  </div>
</section>

<script>
  import { initImageToPdf } from '../../scripts/image-to-pdf';
  document.querySelectorAll<HTMLElement>('[data-image-pdf]').forEach(initImageToPdf);
</script>
