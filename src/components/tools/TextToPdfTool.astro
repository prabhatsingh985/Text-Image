---
import type { UiStrings } from '../../content/types';

interface Props {
  ui: UiStrings;
}

const t = Astro.props.ui.tool;
---

<section class="mx-auto max-w-4xl px-4" data-text-pdf data-i18n={JSON.stringify(t)}>
  <div class="card rounded-[2.5rem] p-4 sm:p-5">
    <textarea class="field min-h-80 w-full resize-y rounded-2xl bg-surface-2/50 p-5 text-[0.95rem] leading-7" placeholder={t.textPlaceholder} dir="auto" data-text></textarea>
    <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3 px-1 text-sm">
      <label class="btn-secondary btn-sm focus-within:outline-2 focus-within:outline-brand-500">
        {t.openTxt}
        <input type="file" accept=".txt,text/plain" class="sr-only" data-file />
      </label>
      <label class="inline-flex items-center gap-2">
        <span class="font-medium text-ink-muted">{t.font}</span>
        <select class="field py-1.5" data-font>
          <option value="sans">{t.fontSans}</option>
          <option value="serif">{t.fontSerif}</option>
          <option value="mono">{t.fontMono}</option>
        </select>
      </label>
      <label class="inline-flex items-center gap-2">
        <span class="font-medium text-ink-muted">{t.fontSize}</span>
        <select class="field py-1.5" data-size>
          {[10, 11, 12, 14, 16, 18].map((s) => <option value={s} selected={s === 12}>{s} pt</option>)}
        </select>
      </label>
      <label class="inline-flex items-center gap-2">
        <span class="font-medium text-ink-muted">{t.pageSize}</span>
        <select class="field py-1.5" data-page>
          <option value="a4">{t.sizeA4}</option>
          <option value="letter">{t.sizeLetter}</option>
        </select>
      </label>
      <label class="inline-flex items-center gap-2">
        <span class="font-medium text-ink-muted">{t.margin}</span>
        <select class="field py-1.5" data-margin>
          <option value="36">{t.marginSmall}</option>
          <option value="72" selected>{t.marginLarge}</option>
        </select>
      </label>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-line px-1 pt-4">
      <span class="me-auto text-xs text-ink-muted" data-count></span>
      <button type="button" class="btn-primary px-6 py-3" data-create>{t.createPdf}</button>
    </div>
    <p class="mt-3 text-xs text-amber-700 dark:text-amber-300" data-warning hidden></p>
  </div>
</section>

<script>
  import { downloadBlob } from '../../lib/export/download';
  import { textToPdf, type FontChoice } from '../../lib/export/pdf';
  import { readTextFile } from '../../lib/input/text-file';
  import { fmt, textStats } from '../../lib/text';
  import { bindFileInput, keepDropsOnPage } from '../../lib/ui/dropzone';
  import { toast } from '../../lib/ui/toast';

  document.querySelectorAll<HTMLElement>('[data-text-pdf]').forEach((root) => {
    const t: Record<string, string> = JSON.parse(root.dataset.i18n || '{}');
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const text = $<HTMLTextAreaElement>('[data-text]');
    const file = $<HTMLInputElement>('[data-file]');
    const count = $('[data-count]');
    const warning = $('[data-warning]');
    const btn = $<HTMLButtonElement>('[data-create]');

    const updateCount = () => {
      count.textContent = textStats(text.value, t);
    };
    text.addEventListener('input', updateCount);

    const openFile = async (f: File) => {
      try {
        text.value = await readTextFile(f);
        updateCount();
      } catch (err) {
        console.error(err);
        toast(t.failed);
      }
    };
    bindFileInput(file, ([f]) => f && openFile(f));

    // A text file dropped on the tool is opened. Text dragged from elsewhere stays a normal drop into the box.
    keepDropsOnPage();
    root.addEventListener('dragover', (e) => e.preventDefault());
    root.addEventListener('drop', (e) => {
      const f = e.dataTransfer?.files[0];
      if (!f) return;
      e.preventDefault();
      if (/^text\//.test(f.type) || /\.(txt|text|md|markdown|csv|tsv|log|json|xml|html?|ini|cfg|yml|yaml)$/i.test(f.name)) openFile(f);
      else toast(t.unsupported);
    });

    btn.addEventListener('click', async () => {
      if (!text.value.trim()) {
        toast(t.emptyText);
        text.focus();
        return;
      }
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = t.creating;
      try {
        const { bytes, replaced, fontsFailed } = await textToPdf(
          text.value,
          {
            font: $<HTMLSelectElement>('[data-font]').value as FontChoice,
            fontSize: Number($<HTMLSelectElement>('[data-size]').value),
            size: $<HTMLSelectElement>('[data-page]').value as 'a4' | 'letter',
            margin: Number($<HTMLSelectElement>('[data-margin]').value),
          },
          () => (btn.textContent = t.loadingFonts),
        );
        warning.hidden = !replaced;
        warning.textContent = fmt(fontsFailed ? t.fontsFailed : t.replaced, { n: replaced });
        downloadBlob(new Blob([bytes as BlobPart], { type: 'application/pdf' }), 'text.pdf');
      } catch (err) {
        console.error(err);
        toast(t.failed);
      } finally {
        btn.textContent = label;
        btn.disabled = false;
      }
    });
  });
</script>
