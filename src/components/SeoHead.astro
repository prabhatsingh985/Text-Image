---
import { SITE } from '../config/site';
import type { Locale } from '../i18n/locales';
import { TOOL_IDS, alternatesFor, urlFor, type PageId } from '../i18n/routes';
import type { FaqItem } from '../content/types';

interface Props {
  title: string;
  description: string;
  pageId: PageId;
  locale: Locale;
  isTool?: boolean;
  faq?: FaqItem[];
  breadcrumbName?: string;
  noindex?: boolean;
}

const { title, description, pageId, locale, isTool = false, faq = [], breadcrumbName, noindex = false } = Astro.props;

const site = SITE.url;
const abs = (href: string) => (href === '/' ? new URL('/', site).href : new URL(href, site).href.replace(/\/$/, ''));
// Built from the route table, not Astro.url, so the build's .html file names never leak in.
const canonical = abs(urlFor(pageId, locale));
const alternates = alternatesFor(pageId);
const xDefault = alternates.find((a) => a.locale.code === 'en');
const fullTitle = pageId === 'image-to-text' ? title : `${title} | ${SITE.name}`;
// 1200×630 share cards in public/og (English) and public/og/<locale>/: one per tool, default.png for every other page.
const isToolPage = (TOOL_IDS as readonly string[]).includes(pageId);
const ogImage = abs(`/og/${locale.code === 'en' ? '' : locale.code + '/'}${isToolPage ? pageId : 'default'}.png`);
// Open Graph wants language_TERRITORY.
const OG_LOCALES: Record<string, string> = { en: 'en_US', es: 'es_ES', pt: 'pt_BR', fr: 'fr_FR', de: 'de_DE', it: 'it_IT', ja: 'ja_JP', ko: 'ko_KR' };
const ogLocale = (l: Locale) => OG_LOCALES[l.code] ?? l.hreflang.replace('-', '_');
const ogImageAlt = isToolPage ? `${breadcrumbName ?? title} – ${SITE.name}` : `${SITE.name} – ${SITE.tagline}`;

const jsonLd: Record<string, unknown>[] = [];
if (isTool) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: breadcrumbName ?? title,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    url: canonical,
    description,
    image: ogImage,
    inLanguage: locale.hreflang,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  });
}
if (pageId === 'image-to-text') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: canonical,
    inLanguage: locale.hreflang,
  });
} else {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: abs('/' + locale.prefix) },
      { '@type': 'ListItem', position: 2, name: breadcrumbName ?? title, item: canonical },
    ],
  });
}
if (faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.locale.hreflang} href={abs(a.href)} />)}
{!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault.href)} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale(locale)} />
{alternates.filter((a) => a.locale.code !== locale.code).map((a) => <meta property="og:locale:alternate" content={ogLocale(a.locale)} />)}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{!noindex && jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
