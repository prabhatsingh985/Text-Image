---
import { SITE } from '../config/site';
import type { Locale } from '../i18n/locales';
import { alternatesFor, urlFor, type PageId } from '../i18n/routes';
import type { FaqItem } from '../content/types';

interface Props {
  title: string;
  description: string;
  pageId: PageId;
  locale: Locale;
  isTool?: boolean;
  faq?: FaqItem[];
  breadcrumbName?: string;
  noindex?: boolean;
}

const { title, description, pageId, locale, isTool = false, faq = [], breadcrumbName, noindex = false } = Astro.props;

const site = SITE.url;
const abs = (href: string) => (href === '/' ? new URL('/', site).href : new URL(href, site).href.replace(/\/$/, ''));
// Built from the route table, not Astro.url, so the build's .html file names never leak in.
const canonical = abs(urlFor(pageId, locale));
const alternates = alternatesFor(pageId);
const xDefault = alternates.find((a) => a.locale.code === 'en');
const fullTitle = pageId === 'image-to-text' ? title : `${title} | ${SITE.name}`;

const jsonLd: Record<string, unknown>[] = [];
if (isTool) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: breadcrumbName ?? title,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    url: canonical,
    description,
    inLanguage: locale.hreflang,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  });
}
if (pageId === 'image-to-text') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: canonical,
    inLanguage: locale.hreflang,
  });
} else {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: abs('/' + locale.prefix) },
      { '@type': 'ListItem', position: 2, name: breadcrumbName ?? title, item: canonical },
    ],
  });
}
if (faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.locale.hreflang} href={abs(a.href)} />)}
{!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault.href)} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={locale.hreflang.replace('-', '_')} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />

{!noindex && jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
