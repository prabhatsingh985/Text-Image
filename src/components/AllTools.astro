---
import ToolIcon from './ToolIcon.astro';
import type { UiStrings } from '../content/types';
import type { Locale } from '../i18n/locales';
import { TOOL_GROUPS, TOOL_META } from '../config/tool-meta';
import { toolIdsFor, urlFor, type ToolId } from '../i18n/routes';
import { contentFor } from '../content';

// Homepage tool directory, right under the main tool: links every other tool,
// grouped like the header menu, so the homepage passes its weight to them.
interface Props {
  currentId: ToolId;
  ui: UiStrings;
  locale: Locale;
}

const { currentId, ui, locale } = Astro.props;
const { tools } = contentFor(locale.code);
const groups = TOOL_GROUPS.map((g) => ({
  id: g.id,
  label: ui.groups[g.id],
  tools: toolIdsFor(locale).filter((id) => id !== currentId && TOOL_META[id].group === g.id),
})).filter((g) => g.tools.length);
---

<section class="mx-auto mt-24 max-w-6xl px-4" aria-labelledby="all-tools">
  <div class="mx-auto max-w-2xl text-center">
    <p class="eyebrow">{ui.common.toolkit}</p>
    <h2 id="all-tools" class="mt-4 font-display text-[2.6rem] leading-none text-balance sm:text-[3.75rem]">{ui.common.allTools}</h2>
  </div>
  <div class="mt-10 grid gap-3 rounded-[2.5rem] bg-surface-3 p-3 sm:p-4 lg:grid-cols-3">
    {
      groups.map((g) => (
        <div class="rounded-3xl bg-surface p-3">
          <h3 class="px-3 pt-2 pb-1 text-xs font-bold tracking-wide text-ink-soft uppercase">{g.label}</h3>
          <ul>
            {g.tools.map((id) => (
              <li>
                <a href={urlFor(id, locale)} class="group flex items-start gap-3.5 rounded-2xl p-3 transition hover:bg-brand-300/20">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-surface-3 text-ink transition group-hover:bg-brand-300 group-hover:text-[#202020]">
                    <ToolIcon id={id} />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="flex items-center gap-2 font-semibold">
                      {tools[id].navLabel}
                      {TOOL_META[id].tag && (
                        <span class="rounded-full bg-brand-300 px-2 py-px text-[0.62rem] font-bold tracking-wide text-[#202020] uppercase">
                          {ui.tags[TOOL_META[id].tag!]}
                        </span>
                      )}
                    </span>
                    <span class="mt-0.5 block text-sm leading-6 text-ink-muted">{tools[id].cardText}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
