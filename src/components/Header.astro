---
import Logo from './Logo.astro';
import ToolIcon from './ToolIcon.astro';
import { SITE } from '../config/site';
import { TOOL_GROUPS, TOOL_META } from '../config/tool-meta';
import { ACTIVE_LOCALES, type Locale } from '../i18n/locales';
import { hasPage, toolIdsFor, urlFor, type PageId } from '../i18n/routes';
import { contentFor } from '../content';

interface Props {
  locale: Locale;
  pageId: PageId;
}

const { locale, pageId } = Astro.props;
const { ui, tools } = contentFor(locale.code);
const groups = TOOL_GROUPS.map((g) => ({
  ...g,
  label: ui.groups[g.id],
  tools: toolIdsFor(locale).filter((id) => TOOL_META[id].group === g.id && TOOL_META[id].menu !== false).map((id) => ({
    id,
    href: urlFor(id, locale),
    label: tools[id].navLabel,
    text: tools[id].cardText,
    tag: TOOL_META[id].tag && ui.tags[TOOL_META[id].tag!],
  })),
})).filter((g) => g.tools.length);
// The most-used tools stay one click away on wide screens.
const quick = (['image-to-text', 'pdf-to-text', 'jpg-to-word'] as const).map((id) => ({ id, href: urlFor(id, locale), label: tools[id].navLabel }));
// The language menu links to this same page in every language, or to that language's homepage when the page is English-only.
const languages = ACTIVE_LOCALES.map((l) => ({ locale: l, href: urlFor(hasPage(pageId, l) ? pageId : 'image-to-text', l) }));
---

<header class="relative z-40">
  <div class="relative mx-auto flex h-16 max-w-6xl items-center gap-2 px-4">
    <a href={urlFor('image-to-text', locale)} class="me-4 flex shrink-0 items-center gap-2.5 font-display text-[1.6rem] leading-none">
      <Logo />
      <span>{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label={ui.nav.tools}>
      <details class="group/menu" data-menu data-hover-menu>
        <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-4 py-2 text-[0.95rem] font-semibold text-ink transition hover:bg-surface-3 group-open/menu:bg-surface-3">
          {ui.nav.allTools}
          <svg class="h-4 w-4 text-ink-muted transition group-open/menu:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.2 7.2a1 1 0 0 1 1.4 0L10 10.6l3.4-3.4a1 1 0 1 1 1.4 1.4l-4.1 4.1a1 1 0 0 1-1.4 0L5.2 8.6a1 1 0 0 1 0-1.4Z" clip-rule="evenodd"></path>
          </svg>
        </summary>
        <div class:list={['card absolute inset-x-4 top-full mt-1 grid animate-fade-up gap-2 rounded-[2rem] p-4', groups.length > 3 ? 'grid-cols-4' : 'grid-cols-3']}>
          {
            groups.map((g) => (
              <div class="rounded-2xl p-2">
                <p class="px-2 pb-2 text-[0.7rem] font-bold tracking-[0.14em] text-ink-soft uppercase">{g.label}</p>
                <ul class="space-y-0.5">
                  {g.tools.map((t) => (
                    <li>
                      <a
                        href={t.href}
                        class:list={[
                          'group/item flex gap-3 rounded-xl p-2 transition hover:bg-surface-2',
                          t.id === pageId && 'bg-surface-2',
                        ]}
                        aria-current={t.id === pageId ? 'page' : undefined}
                      >
                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border-2 border-line bg-surface text-ink transition group-hover/item:border-ink group-hover/item:bg-brand-300 group-hover/item:text-[#202020]">
                          <ToolIcon id={t.id} class="h-[18px] w-[18px]" />
                        </span>
                        <span class="min-w-0">
                          <span class="flex items-center gap-2 text-sm font-semibold">
                            {t.label}
                            {t.tag && (
                              <span class="rounded-full bg-brand-300 px-2 py-px text-[0.62rem] font-bold tracking-wide text-[#202020] uppercase">
                                {t.tag}
                              </span>
                            )}
                          </span>
                          <span class="mt-0.5 line-clamp-2 block text-xs leading-5 text-ink-muted">{t.text}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>
      {
        quick.map((t) => (
          <a
            href={t.href}
            class:list={[
              'hidden rounded-full px-4 py-2 text-[0.95rem] transition hover:bg-surface-3 hover:text-ink lg:block',
              t.id === pageId ? 'text-ink' : 'text-ink-muted',
            ]}
            aria-current={t.id === pageId ? 'page' : undefined}
          >
            {t.label}
          </a>
        ))
      }
    </nav>

    <div class="ms-auto flex items-center gap-1">
      <details class="group/lang relative" data-menu>
        <summary class="btn-ghost h-10 list-none gap-1.5 rounded-full px-3! text-sm font-semibold text-ink group-open/lang:bg-surface-3" aria-label={ui.nav.language}>
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
          </svg>
          <span class="uppercase">{locale.code}</span>
          <svg class="h-4 w-4 text-ink-muted transition group-open/lang:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.2 7.2a1 1 0 0 1 1.4 0L10 10.6l3.4-3.4a1 1 0 1 1 1.4 1.4l-4.1 4.1a1 1 0 0 1-1.4 0L5.2 8.6a1 1 0 0 1 0-1.4Z" clip-rule="evenodd"></path>
          </svg>
        </summary>
        <ul class="card absolute end-0 top-full z-50 mt-2 w-48 animate-fade-up overflow-hidden rounded-2xl p-1.5">
          {
            languages.map((l) => (
              <li>
                <a
                  href={l.href}
                  hreflang={l.locale.hreflang}
                  lang={l.locale.hreflang}
                  class:list={[
                    'flex items-center justify-between gap-3 rounded-xl px-3 py-2 text-sm transition hover:bg-surface-2',
                    l.locale.code === locale.code ? 'bg-surface-2 font-semibold' : 'text-ink-muted hover:text-ink',
                  ]}
                  aria-current={l.locale.code === locale.code ? 'page' : undefined}
                >
                  {l.locale.label}
                  <span class="text-xs font-bold text-ink-soft uppercase">{l.locale.code}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <button id="theme-toggle" type="button" class="btn-ghost h-10 w-10 p-0!" aria-label={ui.nav.theme}>
        <svg class="h-[18px] w-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg class="hidden h-[18px] w-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>

      <details class="group/mob md:hidden" data-menu>
        <summary class="btn-ghost h-10 w-10 list-none p-0!" aria-label={ui.nav.menu}>
          <svg class="h-5 w-5 group-open/mob:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h10"></path>
          </svg>
          <svg class="hidden h-5 w-5 group-open/mob:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </summary>
        <nav class="absolute inset-x-0 top-full h-[calc(100dvh-4rem)] animate-fade-up overflow-y-auto bg-surface-2 px-4 pt-4 pb-10" aria-label={ui.nav.tools}>
          {
            groups.map((g) => (
              <div class="mb-5">
                <p class="px-1 pb-2 text-[0.7rem] font-bold tracking-[0.14em] text-ink-soft uppercase">{g.label}</p>
                <ul class="card divide-y-2 divide-sticker/10 overflow-hidden">
                  {g.tools.map((t) => (
                    <li>
                      <a href={t.href} class="flex items-center gap-3 px-4 py-3 text-sm font-semibold" aria-current={t.id === pageId ? 'page' : undefined}>
                        <ToolIcon id={t.id} class:list={['h-5 w-5', t.id === pageId ? 'text-brand-500' : 'text-ink-muted']} />
                        {t.label}
                        {t.tag && <span class="ms-auto text-[0.62rem] font-bold tracking-wide text-brand-600 uppercase">{t.tag}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  // Close an open menu on outside click or Escape.
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-menu]');
  document.addEventListener('click', (e) => {
    menus.forEach((m) => {
      if (m.open && !m.contains(e.target as Node)) m.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((m) => (m.open = false));
  });

  // On mouse devices the tools menu opens on hover. The short delay lets the pointer cross the gap into the panel.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('[data-hover-menu]').forEach((menu) => {
      let timer: ReturnType<typeof setTimeout> | undefined;
      menu.addEventListener('mouseenter', () => {
        clearTimeout(timer);
        menu.open = true;
      });
      menu.addEventListener('mouseleave', () => {
        timer = setTimeout(() => (menu.open = false), 180);
      });
      // Hover already opened it, so a click must not toggle it shut.
      menu.querySelector('summary')?.addEventListener('click', (e) => {
        e.preventDefault();
        menu.open = true;
      });
    });
  }
</script>
