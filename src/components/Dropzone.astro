---
// The upload target shared by every file tool. Scripts find it by [data-dropzone];
// the buttons (file inputs) go in the default slot.
interface Props {
  title: string;
  hint: string;
  label: string;
  formats?: string[];
}

const { title, hint, label, formats = [] } = Astro.props;
---

<div data-dropzone tabindex="0" role="button" aria-label={label} class="dropzone group">
  <div class="relative mx-auto flex w-fit items-center gap-2.5" aria-hidden="true">
    <div class="relative grid h-14 w-12 -rotate-6 place-items-center overflow-hidden rounded-2xl border-2 border-sticker bg-surface transition duration-300 group-hover:-rotate-12 group-hover:-translate-x-1">
      <svg class="h-6 w-6 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="16" rx="2"></rect>
        <circle cx="9" cy="10" r="1.75"></circle>
        <path d="m21 16-5-5-9 9"></path>
      </svg>
      <div class="absolute inset-x-0 top-1 h-0.5 animate-scan bg-brand-400 [--scan-distance:2.8rem]"></div>
    </div>
    <svg class="h-5 w-5 text-ink transition duration-300 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 10h12M11 5l5 5-5 5"></path>
    </svg>
    <div class="h-14 w-12 rotate-3 rounded-2xl border-2 border-sticker bg-surface px-2 pt-2.5 transition duration-300 group-hover:rotate-6 group-hover:translate-x-1">
      <div class="space-y-1">
        <div class="h-1.5 w-6 rounded-full bg-ink"></div>
        <div class="h-2 w-7 rounded-full bg-brand-300"></div>
        <div class="h-1.5 w-5 rounded-full bg-ink-soft/50"></div>
        <div class="h-1.5 w-7 rounded-full bg-ink-soft/50"></div>
      </div>
    </div>
  </div>

  <p class="relative mt-3 text-lg font-semibold sm:text-xl">{title}</p>
  <p class="relative mx-auto mt-1 max-w-md text-sm text-ink-muted">{hint}</p>
  <div class="relative mt-4 flex flex-wrap justify-center gap-2.5">
    <slot />
  </div>
  {
    formats.length > 0 && (
      <ul class="relative mt-3 flex flex-wrap justify-center gap-1.5" aria-hidden="true">
        {formats.map((f) => (
          <li class="rounded-full bg-surface px-2.5 py-0.5 text-xs font-semibold text-ink-muted">{f}</li>
        ))}
      </ul>
    )
  }
</div>
