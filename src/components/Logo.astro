---
// The mark: a bold "T" (the text we pull out) with a spark (the snap), cut out like a sticker.
// Colours are fixed so the mark reads the same in light and dark themes.
interface Props {
  class?: string;
}
const { class: className = 'h-9 w-9' } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect x="1" y="1" width="30" height="30" rx="10" fill="#aac9f7" stroke="#000" stroke-width="2"></rect>
  <path d="M7 12.25A1.75 1.75 0 0 1 8.75 10.5h10a1.75 1.75 0 0 1 1.75 1.75v.5a1.75 1.75 0 0 1-1.75 1.75H16v9.75A1.75 1.75 0 0 1 14.25 26h-1a1.75 1.75 0 0 1-1.75-1.75V14.5H8.75A1.75 1.75 0 0 1 7 12.75z" fill="#202020"></path>
  <path d="M24.25 4.5q.75 3.75 4.25 4.5-3.5.75-4.25 4.5-.75-3.75-4.25-4.5 3.5-.75 4.25-4.5z" fill="#fff" stroke="#000" stroke-width="1.25" stroke-linejoin="round"></path>
</svg>
