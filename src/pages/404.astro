---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE } from '../i18n/locales';
import { TOOL_IDS, urlFor } from '../i18n/routes';
import { contentFor } from '../content';

const { tools } = contentFor('en');
---

<BaseLayout title="Page not found" description="This page does not exist." pageId="image-to-text" locale={DEFAULT_LOCALE} noindex>
  <section class="mx-auto max-w-2xl px-4 py-20 text-center">
    <p class="font-display text-9xl leading-none text-brand-300">404</p>
    <h1 class="mt-2 font-display text-5xl leading-none">Page not found</h1>
    <p class="mt-3 text-ink-muted">The page you were looking for does not exist. Try one of our free tools:</p>
    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        TOOL_IDS.map((id) => (
          <a href={urlFor(id, DEFAULT_LOCALE)} class="card p-4 font-semibold transition hover:-translate-y-0.5 hover:bg-brand-300/30">
            {tools[id].navLabel}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
